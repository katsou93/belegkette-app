# ---------------------------------------------------------------
# Pflicht — ohne diese startet die Anwendung nicht
# ---------------------------------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Der anon key ist öffentlich und landet im Browser. Das ist so gewollt:
# die Absicherung liegt in der Zeilensicherheit, nicht im Schlüssel.

# ---------------------------------------------------------------
# Serverseitig — niemals in den Browser
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Umgeht die Zeilensicherheit. Nur für den Fristenwächter und den Maileingang.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Beliebige lange Zufallszeichenkette: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------
# Optional
# ---------------------------------------------------------------
# Ohne diese beiden gibt der Fristenwächter den Bericht als JSON zurück,
# statt still nichts zu tun.
RESEND_API_KEY=
FRISTEN_EMPFAENGER=

# Kostenbremse. Vorgabe 200 je Tag und 30 je Stunde, je Nutzer.
KI_LIMIT_TAG=200
KI_LIMIT_STUNDE=30
